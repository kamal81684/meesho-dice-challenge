# Copy to .env and fill in. Never commit .env.
# Start the server with:  uvicorn api.main:app --env-file .env
# (--env-file needs python-dotenv: pip install python-dotenv)

# --- Jev decision layer (TypeSafe System One) ---
# Leave empty to use the built-in rules backend instead of Jev.
# Early access: https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- Vision model for photo extraction (OpenAI-compatible /chat/completions) ---
# Works with Sarvam's API or any self-hosted model that accepts images.
# Leave VISION_MODEL empty to use the built-in photo checks only
# (blur, brightness, resolution, main colour).
VISION_API_BASE=https://api.sarvam.ai/v1
VISION_MODEL=
VISION_API_KEY=
# Set to 0 if your model rejects response_format json_schema.
VISION_JSON_SCHEMA=1

# --- Doc-AI digitise step (Sarvam Doc-AI job API) ---
# When a Doc-AI key is set, each photo is digitised by Doc-AI first and the text
# it reads is handed to the vision model as a hint. Leave empty to call the
# vision model directly on the images.
DOC_AI_API_KEY=
DOC_AI_API_BASE=https://api.sarvam.ai
DOC_AI_LANGUAGE=hi-IN
DOC_AI_CONTENT_TYPE=printed
# How many photos to digitise per request (keeps latency bounded).
DOC_AI_MAX_PHOTOS=3
# Set to 0 to skip the Doc-AI step even when a key is present.
DOC_AI_ENABLED=1
